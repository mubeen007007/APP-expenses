<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/transparent"
  android:orientation="vertical"
  android:padding="5dp">
  <LinearLayout
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_amount_card"
    android:orientation="vertical"
    android:padding="19dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MoneySync." android:textColor="#241A29" android:textSize="18sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Refresh totals" android:gravity="center" android:text="&#x21BB;" android:textColor="#52365F" android:textSize="29sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:orientation="horizontal">
      <TextView android:id="@+id/widget_period_today" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_period_inactive" android:gravity="center" android:text="Today" android:textColor="#493856" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_period_yesterday" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/widget_period_inactive" android:gravity="center" android:text="Yesterday" android:textColor="#493856" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_period_month" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/widget_period_active" android:gravity="center" android:text="Month" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
      <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.13" android:text="MONTH · NET BALANCE" android:textColor="#604C67" android:textSize="11sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:contentDescription="Net balance for selected period" android:ellipsize="end" android:maxLines="1" android:text="Rs 0" android:textColor="#3E285C" android:textSize="50sp" android:textStyle="bold" />
      <TextView android:id="@+id/widget_hero_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Money in minus money out" android:textColor="#604C67" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:orientation="horizontal">
      <LinearLayout android:id="@+id/widget_stat_in" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_stat_card" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="13dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/widget_net_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="TOTAL INCOME" android:textColor="#62486D" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_money_in" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Rs 0" android:textColor="#3E285C" android:textSize="21sp" android:textStyle="bold" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widget_stat_out" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="9dp" android:layout_weight="1" android:background="@drawable/widget_stat_card" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="13dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/widget_out_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="MONEY OUT" android:textColor="#62486D" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_money_out" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Rs 0" android:textColor="#3E285C" android:textSize="21sp" android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_quick_add" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:background="@drawable/widget_quick_button" android:clickable="true" android:contentDescription="Open quick expense entry" android:focusable="true" android:gravity="center" android:text="+  Add expense" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
